# generic C build artifacts
*.o
*.a
*.so

# Python benchmark driver artifacts (tests/performance/*.py)
__pycache__/
*.pyc

# compiled test binaries: one per tests/correctness/test_<noun>.c source.
# Pattern-based (not one line per binary) so a new test_<noun> added later
# is automatically ignored - see README's "every new .h gets a test file"
# policy, which means this list grows with every new header.
tests/correctness/test_*
!tests/correctness/*.c

# compiled binaries for the LAPACKE comparison targets: one correctness
# binary per migrated kernel and one benchmark, same pattern reasoning.
tests/correctness/*_blas_only
tests/correctness/*.asan
tests/performance/*_lapack_removal

# compiled binaries for correctness tests that don't repeat "test" in
# their name (the test's subject is specific enough on its own - see
# each test's own file for the naming reasoning) - one line per binary
# rather than a pattern, since there is no shared prefix to match.
tests/correctness/gzip_inflate
tests/correctness/gzip_deflate
tests/correctness/rdata_array_read
tests/correctness/npz_python_interop

# the statistical test and model suites, named for the question they answer
# rather than the file they test - see README's "Adding files and headers".
# Pattern-based on the question suffix, so a new <subject>_correctness.c
# added later is ignored automatically.
tests/correctness/*_correctness
tests/correctness/qvarma_identification
tests/correctness/qvarma_recovery_study
tests/correctness/qvarma_analytic_agreement
tests/correctness/qvarma_gaussian_limit
tests/performance/qvarma_*
tests/performance/eig_sym_status
tests/performance/lbfgs_candidates
tests/performance/lbfgs_performance
tests/performance/lbfgs_direction_threshold
tests/performance/lbfgs_largest_threshold
tests/performance/lbfgs_copy_threshold

# compiled benchmark binaries, one per tests/performance/bench_<subject>.c,
# and the float64 twin every numeric benchmark gets built with. Both are
# patterns so a new benchmark or a new precision variant is covered without
# another line here.
tests/performance/bench_*
tests/performance/small_blas_threshold*
!tests/performance/*.c

# compiled integration binaries. Every file in tests/integration/ is a test,
# and none of them shares a prefix or a suffix with another - each is named
# for the seam it covers - so this ignores the whole directory except its
# sources, rather than growing a line per binary.
tests/integration/*
!tests/integration/*.c

# results written by the benchmarks and by any pipeline run
out/

# compiled example binaries: one per examples/<noun>_example.c source, same
# auto-covering reasoning as above. encoder is named separately because it is
# the one example whose name does not end in _example.
examples/*_example
!examples/*_example.c
examples/encoder
!examples/encoder.c
mat_example
